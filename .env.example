# 複製此檔為 .env.local 並填入真實值（.env.local 已被 .gitignore 忽略）
# 與後台共用的密鑰：保護本站 /api/revalidate，也用於回敲後台的 /api/revalidate
ADMIN_SECRET_TOKEN=

# 後台網址（如 https://admin.example.com）：下單扣庫存後回敲其 /api/revalidate，
# 讓後台商品快取同步失效；留空則跳過通知（本地開發可不設）
ADMIN_URL=

# Neon Postgres 連線字串（Neon Console > Connection Details，建議用 pooled 連線）
DATABASE_URL=